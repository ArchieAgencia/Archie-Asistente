# Valores de ejemplo (falsos). Los reales viven en Coolify y en Bitwarden, nunca en git.
PORT=8800
NODE_ENV=production
ARCHIE_VERSION=0.0.1
# Conexión de la APLICACIÓN (rol archie_app, nunca el dueño ni un superusuario). Valor falso:
DATABASE_URL=postgres://archie_app:cambiar-esto@db:5432/archie
# Dirección pública del panel (https obligatorio en producción). Las peticiones de otros sitios se rechazan.
ARCHIE_ORIGEN=https://archieai.ejemplo.com
# Proxies delante de la app: 1 con Coolify/Traefik; 2 si además hay Cloudflare. Si queda mal, la IP real no se detecta.
ARCHIE_PROXY_SALTOS=1
# Claves maestras para cifrar secretos: lista versión:base64 (32 bytes). Generar: openssl rand -base64 32
ARCHIE_CLAVES_MAESTRAS=1:CAMBIAR_POR_BASE64_DE_32_BYTES
ARCHIE_CLAVE_ACTIVA=1

# Correo del sistema (invitaciones). En producción debe ser resend; "consola" NO envía nada (solo desarrollo).
ARCHIE_CORREO=resend
RESEND_API_KEY=re_CAMBIAR_POR_LA_CLAVE_REAL
ARCHIE_CORREO_REMITENTE=Archie AI <no-responder@ejemplo.com>
# Etapa de pruebas: solo se envía a estas direcciones o dominios (separados por coma). Quitar al salir a clientes reales.
# ARCHIE_CORREO_SOLO_A=delivered@resend.dev,@ejemplo.com

# Solo para tareas de operador (comandos de dist/cli), no para el servicio:
# ARCHIE_OWNER_URL=postgres://archie_owner:...@db:5432/archie

# --- Asistente (F1: chat de solo lectura) ---
# Proveedor de IA. "simulado" NO llama a nadie (solo desarrollo). En producción debe ser archie.
ARCHIE_IA=archie
ARCHIE_IA_CLAVE=CAMBIAR_POR_LA_CLAVE_REAL
# Nombre del modelo, tal como lo publica el proveedor (cambia con el tiempo: nunca va escrito en el código).
ARCHIE_IA_MODELO=CAMBIAR_POR_EL_MODELO
# Precios en micro-dólares por millón de tokens (1 USD = 1000000). Solo sirven para estimar el costo registrado; con 0 el costo queda en 0.
ARCHIE_IA_PRECIO_ENTRADA=0
ARCHIE_IA_PRECIO_SALIDA=0
ARCHIE_IA_PRECIO_CACHE=0
ARCHIE_IA_MAX_TOKENS=1024
ARCHIE_IA_MAX_PASOS=6
# Origen de Archie Send. Lo fija el servidor: los clientes no escriben direcciones (evita SSRF).
ARCHIE_SEND_URL=https://send.ejemplo.com
# Contactos en el chat: apagado hasta la revisión legal (Ley 1581). Solo "si" con datos de prueba o internos.
ARCHIE_IA_CONTACTOS=no

# Verificación en dos pasos de los administradores de cada cuenta. En producción debe ser obligatorio.
ARCHIE_2FA_ADMIN=obligatorio
